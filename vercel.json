{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/herramientas/libreta",
      "destination": "/mascotas",
      "permanent": false
    },
    {
      "source": "/herramientas/libreta/:path*",
      "destination": "/mascotas",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/producto?id=:id"
    },
    {
      "source": "/propuesta/:id",
      "destination": "/propuesta"
    },
    {
      "source": "/mascota/:t",
      "destination": "/mascota"
    },
    {
      "source": "/cuida/:t",
      "destination": "/mascota"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/leads",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/mascotas",
      "schedule": "0 12 * * *"
    }
  ]
}
