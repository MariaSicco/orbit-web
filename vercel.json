{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/herramientas/libreta",
      "destination": "/mascotas",
      "permanent": false
    },
    {
      "source": "/herramientas/libreta/:path*",
      "destination": "/mascotas",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/producto?id=:id"
    },
    {
      "source": "/propuesta/:id",
      "destination": "/propuesta"
    },
    {
      "source": "/mascotas/gmail/callback",
      "destination": "/api/mascotas?gmail=callback"
    },
    {
      "source": "/mascotas/outlook/callback",
      "destination": "/api/mascotas?outlook=callback"
    },
    {
      "source": "/mascota/:t",
      "destination": "/mascota"
    },
    {
      "source": "/cuida/:t",
      "destination": "/mascota"
    },
    {
      "source": "/herramientas/:slug",
      "destination": "/api/herramienta?slug=:slug"
    },
    {
      "source": "/herramientas/:slug/:path*",
      "destination": "/api/herramienta?slug=:slug&path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/leads",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/mascotas",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/herramientas/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/e/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/herramienta.js": {
      "includeFiles": "api/_herramientas/**"
    }
  }
}
