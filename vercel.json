{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/p/:id",
      "destination": "/api/producto?id=:id"
    },
    {
      "source": "/casa/:token",
      "destination": "/api/vencimientos-casa?unirse=:token"
    },
    {
      "source": "/propuesta/:id",
      "destination": "/propuesta"
    },
    {
      "source": "/herramientas/:slug",
      "destination": "/api/herramienta?slug=:slug"
    },
    {
      "source": "/herramientas/:slug/:path*",
      "destination": "/api/herramienta?slug=:slug&path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/leads",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/vencimientos",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/herramientas/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/herramienta.js": {
      "includeFiles": "api/_herramientas/**"
    },
    "api/leer-factura.js": {
      "maxDuration": 60
    },
    "api/vencimientos-resumen.js": {
      "maxDuration": 60
    }
  }
}
