{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/mi-mes/mail/:prov",
      "destination": "/api/mi-mes-mail?accion=callback&prov=:prov"
    },
    {
      "source": "/p/:id",
      "destination": "/api/producto?id=:id"
    },
    {
      "source": "/propuesta/:id",
      "destination": "/propuesta"
    },
    {
      "source": "/herramientas/:slug",
      "destination": "/api/herramienta?slug=:slug"
    },
    {
      "source": "/herramientas/:slug/:path*",
      "destination": "/api/herramienta?slug=:slug&path=:path*"
    },
    {
      "source": "/regalo/:t",
      "destination": "/api/regalo?t=:t"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/leads",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/mi-mes",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/herramientas/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/herramientas/mi-mes/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/herramientas/"
        }
      ]
    },
    {
      "source": "/e/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/herramienta.js": {
      "includeFiles": "api/_herramientas/**"
    },
    "api/leer-resumen.js": {
      "maxDuration": 60
    },
    "api/mi-mes-leer.js": {
      "maxDuration": 60
    },
    "api/mi-mes-mail.js": {
      "maxDuration": 120
    },
    "api/cron/mi-mes.js": {
      "maxDuration": 300
    },
    "api/iva/extraer.js": {
      "maxDuration": 60
    },
    "api/iva/asistente.js": {
      "maxDuration": 60
    }
  }
}
